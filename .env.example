# Copy to .env and fill in. The server reads this; the key never reaches the
# browser. You can also set it from Setup -> API key inside the app.
#
# Get one at https://fish.audio/app/developers
FISH_API_KEY=

# ---- optional overrides ----------------------------------------------------
# Where the Wicked Roguelike checkout lives. Defaults to
# C:\Users\PC\Documents\content\wicked\RoguelikeGame
# ROGUELIKE_ROOT=

# The dialogue art folder that /api/avatars scans.
# Defaults to <ROGUELIKE_ROOT>\assets\dialogue
# ROGUELIKE_DIALOGUE_DIR=

# The default avatar (must match a folder name under the dialogue dir).
# ROGUELIKE_AVATAR_DIR=

# Interpreter that has openfacefx + numpy. The studio venv deliberately does
# not carry torch, so the baker is shelled out to the system Python.
# VISEME_PYTHON=
